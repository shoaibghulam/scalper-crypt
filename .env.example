# Copy to .env and fill in. .env is gitignored and must never be committed.

# ---------------------------------------------------------------------------
# Environment: testnet | paper | live
#
#   testnet  Binance futures testnet. Proves API wiring only. Testnet spreads
#            are roughly 265x too wide and depth roughly 250x too deep, so it
#            cannot tell you whether a strategy is profitable.
#   paper    Live market data, fills simulated locally against the real book.
#            This is the mode that validates an edge.
#   live     Real money. Also requires TRADING_MODE below.
# ---------------------------------------------------------------------------
BINANCE_ENV=testnet

# Futures testnet keys come from testnet.binancefuture.com (GitHub sign-in,
# separate from your real Binance account). Live keys must have Reading and
# Futures enabled, Withdrawals DISABLED, and an IP whitelist set. Keys without
# an IP restriction expire after 30 days.
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Max age of a signed request, in milliseconds. Do not inflate this to paper
# over clock drift; fix the clock instead.
BINANCE_RECV_WINDOW_MS=5000

# ---------------------------------------------------------------------------
# Live-money arming switch.
#
# Deliberately separate from BINANCE_ENV and deliberately outside the app: no
# UI control can set this. The engine refuses to start with BINANCE_ENV=live
# unless TRADING_MODE=live is present in the environment.
# ---------------------------------------------------------------------------
# TRADING_MODE=live

# ---------------------------------------------------------------------------
# Local services. Bound to loopback; there is no authentication yet, so do not
# expose either port.
# ---------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
ENGINE_HOST=127.0.0.1
ENGINE_PORT=8765

# Where the SQLite files and Parquet candle archives live.
DATA_DIR=./data

# Fernet key encrypting stored exchange credentials. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this OUT of the database it protects, in a file with 0600 permissions.
MASTER_KEY_FILE=./master.key

MAX_POSITIONS=5
MAX_LEVERAGE=10
MAX_TRADE_RISK=0.01
MAX_MARGIN_FRACTION=0.50
DAILY_LOSS_FRACTION=0.03
